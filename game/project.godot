; Quantum Matter Explorer — Phase G2, self-contained Godot 4.x prototype.
config_version=5

[application]
config/name="Quantum Matter Explorer"
run/main_scene="res://scenes/GameMenu.tscn"
config/description="Quantum-inspired platforming and measurement puzzles; the toy mechanics are not research QMC."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
2d/default_gravity=1300.0

[gui]
theme/default_font_size=17
