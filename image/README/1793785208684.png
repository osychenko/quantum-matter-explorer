diff --git a/web/src/missionExperience.ts b/web/src/missionExperience.ts
new file mode 100644
index 0000000..bc48611
--- /dev/null
+++ b/web/src/missionExperience.ts
@@ -0,0 +1,41 @@
+/** Patch 36: presentation-only guidance derived from verified mission evidence.
+ * Do not infer physical claims or trust user-supplied text as simulation output.
+ */
+import type {Finding, Mission, Prediction} from './missionEngine';
+
+export type MissionStage = 'predict' | 'collect' | 'interpret' | 'review';
+export function missionStage(prediction:Prediction|null, finding:Finding|null, feedback:boolean):MissionStage {
+  if (feedback) return 'review';
+  if (finding) return 'interpret';
+  if (prediction) return 'collect';
+  return 'predict';
+}
+
+export function observedOutcome(mission:Mission, finding:Finding):string {
+  if (mission.kind === 'reference') {
+    if (finding.zScore === null || !Number.isFinite(finding.zScore)) throw new Error('Missing reference comparison');
+    return `The measured difference is ${finding.zScore.toFixed(2)} reported standard errors from the K=2 reference. ${finding.zScore <= 2 ? 'It passes this two-SEM screening rule.' : 'It fails this two-SEM screening rule.'} Neither outcome proves the physical model correct or incorrect.`;
+  }
+  const names=finding.summaries;
+  if (names.length !== 2) throw new Error('Pair mission requires two observations');
+  const phrase=finding.comparison === 'higher' ? 'higher than' : finding.comparison === 'lower' ? 'lower than' : 'approximately equal to';
+  return `“${names[1].label}” is ${phrase} “${names[0].label}” for this specific Green-function observable. The numerical difference is ${finding.difference.toFixed(5)}.`;
+}
+
+export function learningSteps(stage:MissionStage):ReadonlyArray<{id:MissionStage;title:string;detail:string}> {
+  return [
+    {id:'predict',title:'Predict',detail:'Choose a hypothesis before seeing the result'},
+    {id:'collect',title:'Collect',detail:'Request curated numerical evidence'},
+    {id:'interpret',title:'Interpret',detail:'Explain what the evidence supports'},
+    {id:'review',title:'Reflect',detail:'Read the explanation and record the discovery'},
+  ];
+}
+
+export const RESEARCH_GLOSSARY = [
+  {term:'Inverse temperature β',definition:'A parameter inversely proportional to temperature when the relevant energy units are fixed. Larger β means colder.'},
+  {term:'Green function',definition:'The quantity used in these missions describes particle addition at an imaginary-time separation. It is not a real-time particle trajectory.'},
+  {term:'Periodic cell',definition:'A simulation box repeated in every direction. Opposite sides represent the same spatial location.'},
+  {term:'Recorded benchmark',definition:'A saved result of a previous Monte Carlo experiment. Viewing it is not running a new simulation.'},
+  {term:'Replica SEM',definition:'The standard error estimated from independently seeded chain results. It represents sampling uncertainty, not all systematic biases.'},
+  {term:'Spectral reference',definition:'An independently computed finite-basis comparison. Matching it is a useful check, not a proof of continuum convergence.'},
+] as const;
diff --git a/web/src/missions.css b/web/src/missions.css
index 8873da2..d0aa030 100644
--- a/web/src/missions.css
+++ b/web/src/missions.css
@@ -40,3 +40,35 @@ button:focus-visible,input:focus-visible,textarea:focus-visible,.mission-option:
 @media(max-width:1100px) {.mission-layout {grid-template-columns:1fr}.mission-steps {grid-template-columns:repeat(2,minmax(0,1fr))}.mission-map {order:0}.mission-active {order:1}}
 @media(max-width:650px) {.mission-dashboard {display:block}.mission-dashboard-meter {width:100%;margin-top:23px}.mission-steps {grid-template-columns:1fr}.mission-active {padding:18px}.mission-measurement-header {display:block}.mission-origin {display:block;margin-top:7px}.mission-dashboard-lead h2 {font-size:23px}}
 @media(prefers-reduced-motion:reduce) {.mission-meter div,.mission-option {transition:none}}
+/* Patch 36: onboarding, explicit study stages, and accessible review. */
+.mission-guide{margin-bottom:20px;border-color:#365968}
+.mission-guide-head{display:flex;justify-content:space-between;align-items:center;gap:18px}
+.mission-guide-head h2{font-size:19px;margin:7px 0 0}
+.mission-guide-body{color:#c5d6e1;font-size:13px;line-height:1.8;max-width:1000px}
+.mission-guide-body p{margin:15px 0}
+.mission-guide-body strong{color:#e0f6ed}
+.mission-text-button{color:#8bead9;background:transparent;border:0;text-decoration:underline;cursor:pointer;padding:10px 0;font:inherit}
+.mission-glossary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:10px 0}
+.mission-glossary>div{padding:12px;background:#101f30;border:1px solid #36516a;border-radius:9px}
+.mission-glossary dt{color:#d7f7ee;font-weight:bold}
+.mission-glossary dd{margin:5px 0 0;color:#aac3d2;line-height:1.65}
+.mission-process ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;list-style:none;margin:19px 0 0;padding:0}
+.mission-process li{min-width:0;display:flex;align-items:center;gap:6px;font-size:11px;color:#90a9ba}
+.mission-process li span{display:grid;place-items:center;flex-shrink:0;width:24px;height:24px;border:1px solid #3a596e;border-radius:50%}
+.mission-process li.current{color:#dffef0}.mission-process li.current span{background:#28766c;border-color:#7be2cb}
+.mission-process li.done{color:#a6e0c9}.mission-process li.done span{border-color:#6abfa8}
+.mission-stage-help{color:#b6cdcf;font-size:12px;line-height:1.5;margin:12px 0 20px}
+.mission-observation-explanation{border-left:3px solid #6ed7bf;background:#19313d;color:#dcf5ee;padding:13px;font-size:13px;line-height:1.75}
+.mission-error{border:1px solid #cc9277;border-radius:9px;background:#322c30;color:#ffe5d4;padding:15px;margin-top:20px;font-size:13px;line-height:1.7}
+.mission-error p{margin:5px 0}
+.mission-next-question{background:#132b35;padding:12px;border-radius:8px}
+#mission-title:focus{outline:none}
+@media(max-width:650px){.mission-glossary{grid-template-columns:1fr}.mission-process li{flex-direction:column;text-align:center}.mission-process li strong{font-size:10px}.mission-guide-head{align-items:flex-start}}
+@media(prefers-reduced-motion:reduce){.mission-process *, .mission-guide *{transition:none!important;animation:none!important}}
+.mission-playtest{margin-top:20px}
+.mission-playtest h2{margin:10px 0;font-size:20px}
+.mission-playtest>p{font-size:13px;line-height:1.7;color:#bdd1dc}
+.mission-playtest-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin:18px 0}
+.mission-playtest-fields label{color:#d6e7ef;font-size:12px;line-height:1.5}
+.mission-playtest-fields textarea{display:block;margin-top:7px;width:100%;padding:10px;border:1px solid #476072;border-radius:8px;background:#0e2131;color:#f0fafb;resize:vertical;min-height:70px}
+@media(max-width:800px){.mission-playtest-fields{grid-template-columns:1fr}}
diff --git a/web/tests/mission-engine.test.mjs b/web/tests/mission-engine.test.mjs
index 31406d2..2f90ad9 100644
--- a/web/tests/mission-engine.test.mjs
+++ b/web/tests/mission-engine.test.mjs
@@ -13,13 +13,14 @@ const tmp=mkdtempSync(join(tmpdir(),'qme-mission-test-'));
 const tsc=process.platform==='win32'?'tsc.cmd':'tsc';
 try {
   execFileSync(tsc,["--strict","--target","ES2021","--module","commonjs","--skipLibCheck",
-    "--outDir",tmp,"src/missionEngine.ts"],{cwd:webRoot,stdio:'pipe'});
+    "--outDir",tmp,"src/missionEngine.ts","src/missionExperience.ts"],{cwd:webRoot,stdio:'pipe'});
 } catch(e) {
   rmSync(tmp,{recursive:true,force:true});
   throw new Error(`Mission engine TypeScript compilation failed: ${e.stderr?.toString() || e.message}`);
 }
 const require=createRequire(import.meta.url);
 const engine=require(join(tmp,'missionEngine.js'));
+const experience=require(join(tmp,'missionExperience.js'));
 process.on('exit',()=>rmSync(tmp,{recursive:true,force:true}));
 const {MISSIONS,EMPTY_PROGRESS,assessEvidence,recordCompletion,totalXp,isUnlocked,earnedBadges,validatedProgress}=engine;
 
@@ -108,3 +109,35 @@ test('bounded storage recovery, stable achievements and graduated unlocks',()=>{
   assert.equal(totalXp(two),80);
   assert.equal(isUnlocked(two,MISSIONS[2]),true);
 });
+
+
+test('mission guidance transitions never reveal an outcome before evidence',()=>{
+  const {missionStage,learningSteps}=experience;
+  const mission=m('thermal-detective');
+  assert.equal(missionStage(null,null,false),'predict');
+  assert.equal(missionStage('higher',null,false),'collect');
+  const evidence=assessEvidence(mission,[synthetic(mission.evidence[0],1.2),synthetic(mission.evidence[1],1.9)]);
+  assert.equal(missionStage('lower',evidence,false),'interpret');
+  assert.equal(missionStage('lower',evidence,true),'review');
+  assert.deepEqual(learningSteps('interpret').map(s=>s.id),['predict','collect','interpret','review']);
+});
+
+test('plain-language outcome derives from observed values, never predicted answer',()=>{
+  const {observedOutcome}=experience;
+  const mission=m('thermal-detective');
+  const up=assessEvidence(mission,[synthetic(mission.evidence[0],1.0),synthetic(mission.evidence[1],1.7)]);
+  const down=assessEvidence(mission,[synthetic(mission.evidence[0],2.0),synthetic(mission.evidence[1],1.3)]);
+  assert.match(observedOutcome(mission,up),/higher than/);
+  assert.match(observedOutcome(mission,down),/lower than/);
+  const referenceMission=m('uncertainty-investigator');
+  assert.match(observedOutcome(referenceMission,assessEvidence(referenceMission,[synthetic(referenceMission.evidence[0],1.685)])),/passes this two-SEM screening/);
+  assert.match(observedOutcome(referenceMission,assessEvidence(referenceMission,[synthetic(referenceMission.evidence[0],2.1)])),/fails this two-SEM screening/);
+  assert.match(observedOutcome(referenceMission,assessEvidence(referenceMission,[synthetic(referenceMission.evidence[0],1.685)])),/not.*proves|Neither outcome proves/);
+});
+
+test('glossary distinguishes imaginary time, history and uncertainty',()=>{
+  const terms=experience.RESEARCH_GLOSSARY;
+  assert(terms.length>=5);
+  assert(terms.some(item=>/Green function/.test(item.term) && /not a real-time/.test(item.definition)));
+  assert(terms.some(item=>/Recorded benchmark/.test(item.term) && /not running/.test(item.definition)));
+});
